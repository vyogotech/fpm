# FPM - Git Ignore

# Binaries
fpm
fpm-*
!fpm-repo-README.md
*.exe
main

# Build artifacts
bin/
dist/
*.out

# Environment files with secrets
.env

# Nginx authentication file (contains password hashes)
nginx/.htpasswd

# Test packages
*.fpm
!**/*.fpm.go

# Coverage reports
coverage.out
coverage.html
*.coverprofile

# Log files
*.log

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.iml

# Container volumes (if using local bind mounts)
data/

# Go specific
vendor/

# Test cache
.cache/
.fpm/


